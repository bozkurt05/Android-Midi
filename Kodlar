@SuppressLint("MissingPermission")
class OrgMidiManager(
    private val context: Context,
    private val onStatus: (String) -> Unit
) {
    private class OpenDev(val device: MidiDevice, val ports: List<MidiOutputPort>, val name: String)

    private val main = Handler(Looper.getMainLooper())
    private val midi = context.getSystemService(Context.MIDI_SERVICE) as MidiManager
    private val open = HashMap<Int, OpenDev>()
    private var scanner: BluetoothLeScanner? = null
    private var scanCb: ScanCallback? = null

    var baseNote = 48 // C3

    private val deviceCallback = object : MidiManager.DeviceCallback() {
        override fun onDeviceAdded(info: MidiDeviceInfo) = openDevice(info)
        override fun onDeviceRemoved(info: MidiDeviceInfo) = closeDevice(info.id)
    }

    // ---------- Yaşam döngüsü ----------
    fun start() {
        midi.registerDeviceCallback(deviceCallback, main)
        @Suppress("DEPRECATION")
        midi.devices.forEach { openDevice(it) }
        updateStatus()
    }

    fun stop() {
        stopScan()
        runCatching { midi.unregisterDeviceCallback(deviceCallback) }
        open.keys.toList().forEach { closeDevice(it) }
        NativeAudio.nativeAllNotesOff()
    }

    // ---------- USB / Bluetooth MIDI ----------
    private fun openDevice(info: MidiDeviceInfo) {
        if (info.outputPortCount == 0 || open.containsKey(info.id)) return
        midi.openDevice(info, MidiManager.OnDeviceOpenedListener { dev ->
            if (dev != null) attach(dev)
        }, main)
    }

    private fun attach(dev: MidiDevice) {
        val info = dev.info
        if (open.containsKey(info.id) || info.outputPortCount == 0) { dev.close(); return }
        val ports = (0 until info.outputPortCount).mapNotNull { i ->
            dev.openOutputPort(i)?.also { it.connect(PortReceiver()) }
        }
        val name = info.properties.getString(MidiDeviceInfo.PROPERTY_NAME)
            ?: info.properties.getString(MidiDeviceInfo.PROPERTY_PRODUCT)
            ?: "MIDI #${info.id}"
        open[info.id] = OpenDev(dev, ports, name)
        updateStatus()
    }

    private fun closeDevice(id: Int) {
        val d = open.remove(id) ?: return
        d.ports.forEach { runCatching { it.close() } }
        runCatching { d.device.close() }
        NativeAudio.nativeAllNotesOff()
        updateStatus()
    }

    fun connectBluetooth(dev: BluetoothDevice) {
        onStatus("Bluetooth bağlanıyor…")
        midi.openBluetoothDevice(dev, MidiManager.OnDeviceOpenedListener { d ->
            if (d != null) attach(d) else onStatus("Bluetooth MIDI bağlantısı başarısız")
        }, main)
    }

    fun scanBluetooth(durationMs: Long = 6000, onDone: (List<BluetoothDevice>) -> Unit) {
        val bm = context.getSystemService(Context.BLUETOOTH_SERVICE) as BluetoothManager
        val sc = bm.adapter?.takeIf { it.isEnabled }?.bluetoothLeScanner
        if (sc == null) { onStatus("Bluetooth kapalı veya yok"); onDone(emptyList()); return }
        stopScan()
        val found = LinkedHashMap<String, BluetoothDevice>()
        val cb = object : ScanCallback() {
            override fun onScanResult(callbackType: Int, result: ScanResult) {
                found[result.device.address] = result.device
            }
        }
        val filter = ScanFilter.Builder()
            .setServiceUuid(ParcelUuid.fromString("03B80E5A-EDE8-4B33-A751-6CE34EC4C700"))
            .build()
        val settings = ScanSettings.Builder().setScanMode(ScanSettings.SCAN_MODE_LOW_LATENCY).build()
        scanner = sc
        scanCb = cb
        sc.startScan(listOf(filter), settings, cb)
        main.postDelayed({ stopScan(); onDone(found.values.toList()) }, durationMs)
    }

    private fun stopScan() {
        val cb = scanCb ?: return
        runCatching { scanner?.stopScan(cb) }
        scanCb = null
    }

    private fun updateStatus() {
        onStatus(
            if (open.isEmpty()) "MIDI: cihaz bağlı değil (PC klavye tuşları aktif)"
            else "MIDI: ${open.size} cihaz bağlı → " + open.values.joinToString { it.name }
        )
    }

    // ---------- MIDI ayrıştırıcı ----------
    private inner class PortReceiver : MidiReceiver() {
        override fun onSend(msg: ByteArray, offset: Int, count: Int, timestamp: Long) {
            var i = offset
            val end = offset + count
            while (i < end) {
                val st = msg[i].toInt() and 0xFF
                when {
                    st < 0x80 || st >= 0xF8 -> i++
                    st == 0xF0 -> {
                        while (i < end && (msg[i].toInt() and 0xFF) != 0xF7) i++
                        i++
                    }
                    st >= 0xF0 -> i += when (st) { 0xF1, 0xF3 -> 2; 0xF2 -> 3; else -> 1 }
                    else -> {
                        val type = st and 0xF0
                        val len = if (type == 0xC0 || type == 0xD0) 2 else 3
                        if (i + len > end) return
                        val d1 = msg[i + 1].toInt() and 0x7F
                        val d2 = if (len == 3) msg[i + 2].toInt() and 0x7F else 0
                        handle(type, d1, d2)
                        i += len
                    }
                }
            }
        }
    }

    private fun handle(type: Int, d1: Int, d2: Int) {
        when (type) {
            0x90 -> if (d2 > 0) NativeAudio.nativeNoteOn(d1, d2 / 127f) else NativeAudio.nativeNoteOff(d1)
            0x80 -> NativeAudio.nativeNoteOff(d1)
            0xB0 -> if (d1 == 123 || d1 == 120) NativeAudio.nativeAllNotesOff()
        }
    }

    // ---------- PC klavye (Prodikeys QWERTY bölümü dahil) ----------
    private val keyMap = mapOf(
        KeyEvent.KEYCODE_Z to 0, KeyEvent.KEYCODE_S to 1, KeyEvent.KEYCODE_X to 2,
        KeyEvent.KEYCODE_D to 3, KeyEvent.KEYCODE_C to 4, KeyEvent.KEYCODE_V to 5,
        KeyEvent.KEYCODE_G to 6, KeyEvent.KEYCODE_B to 7, KeyEvent.KEYCODE_H to 8,
        KeyEvent.KEYCODE_N to 9, KeyEvent.KEYCODE_J to 10, KeyEvent.KEYCODE_M to 11,
        KeyEvent.KEYCODE_Q to 12, KeyEvent.KEYCODE_2 to 13, KeyEvent.KEYCODE_W to 14,
        KeyEvent.KEYCODE_3 to 15, KeyEvent.KEYCODE_E to 16, KeyEvent.KEYCODE_R to 17,
        KeyEvent.KEYCODE_5 to 18, KeyEvent.KEYCODE_T to 19, KeyEvent.KEYCODE_6 to 20,
        KeyEvent.KEYCODE_Y to 21, KeyEvent.KEYCODE_7 to 22, KeyEvent.KEYCODE_U to 23,
        KeyEvent.KEYCODE_I to 24, KeyEvent.KEYCODE_9 to 25, KeyEvent.KEYCODE_O to 26,
        KeyEvent.KEYCODE_0 to 27, KeyEvent.KEYCODE_P to 28
    )

    /** Activity.dispatchKeyEvent içinden çağır. Tuş işlendiyse true döner. */
    fun handleKeyEvent(e: KeyEvent): Boolean {
        val off = keyMap[e.keyCode] ?: return false
        val note = baseNote + off
        when (e.action) {
            KeyEvent.ACTION_DOWN -> if (e.repeatCount == 0) NativeAudio.nativeNoteOn(note, 0.8f)
            KeyEvent.ACTION_UP -> NativeAudio.nativeNoteOff(note)
        }
        return true
    }
}
package com.example.orientalorg

class KomaManager(private val centsDown: Float = 50f) {
    val noteNames = arrayOf("C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B")
    private val active = BooleanArray(12)

    fun isActive(pitchClass: Int) = active[pitchClass]

    /** Seçilen notanın tüm oktavlarını 50 cent aşağı çeker (kapalıyken 0). */
    fun set(pitchClass: Int, enabled: Boolean) {
        active[pitchClass] = enabled
        NativeAudio.nativeSetKomaCents(pitchClass, if (enabled) -centsDown else 0f)
    }

    fun toggle(pitchClass: Int): Boolean {
        set(pitchClass, !active[pitchClass])
        return active[pitchClass]
    }

    fun resetAll() { for (i in 0 until 12) set(i, false) }
}
