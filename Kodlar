#include <oboe/Oboe.h>
#include <atomic>
#include <array>
#include <cmath>
#include <cstring>
#include <memory>
#include <mutex>

namespace {
constexpr int kMaxVoices = 16;
constexpr float kTwoPi = 6.283185307179586f;

struct Voice {
    std::atomic<bool> gate{false};
    std::atomic<int> note{-1};
    std::atomic<float> velocity{0.f};
    std::atomic<uint32_t> trigger{0};
    std::atomic<float> level{0.f};
    // sadece ses thread'i
    uint32_t seenTrigger = 0;
    int curNote = -1;
    float curVel = 0.f;
    float phase = 0.f;
    float env = 0.f;
};

class Engine : public oboe::AudioStreamCallback {
public:
    Engine() { for (auto &k : koma) k.store(0.f); }

    bool start() { wanted = true; return open(); }

    void stop() {
        wanted = false;
        std::lock_guard<std::mutex> lk(mtx);
        if (stream) {
            stream->stop();
            stream->close();
            stream.reset();
        }
    }

    void noteOn(int note, float vel) {
        if (vel < 0.f) vel = 0.f;
        if (vel > 1.f) vel = 1.f;
        int idx = -1;
        for (int i = 0; i < kMaxVoices; i++)
            if (voices[i].note.load() == note && active(voices[i])) { idx = i; break; }
        if (idx < 0)
            for (int i = 0; i < kMaxVoices; i++)
                if (!active(voices[i])) { idx = i; break; }
        if (idx < 0) idx = (int)(rr.fetch_add(1) % kMaxVoices);
        Voice &v = voices[idx];
        v.note.store(note);
        v.velocity.store(vel);
        v.gate.store(true);
        v.trigger.fetch_add(1, std::memory_order_release);
    }

    void noteOff(int note) {
        for (auto &v : voices)
            if (v.note.load() == note && v.gate.load()) v.gate.store(false);
    }

    void allNotesOff() { for (auto &v : voices) v.gate.store(false); }

    void setKoma(int pc, float cents) { if (pc >= 0 && pc < 12) koma[pc].store(cents); }
    void setMaster(float m) { master.store(m < 0.f ? 0.f : (m > 1.f ? 1.f : m)); }

    oboe::DataCallbackResult onAudioReady(oboe::AudioStream *, void *audioData,
                                          int32_t numFrames) override {
        float *out = static_cast<float *>(audioData);
        const int ch = channels;
        const float sr = sampleRate;
        std::memset(out, 0, sizeof(float) * numFrames * ch);

        const float atk = 1.f / (0.005f * sr);
        const float rel = std::exp(-1.f / (0.08f * sr));

        for (auto &v : voices) {
            uint32_t t = v.trigger.load(std::memory_order_acquire);
            if (t != v.seenTrigger) {
                v.seenTrigger = t;
                v.curNote = v.note.load();
                v.curVel = v.velocity.load();
            }
            const bool gate = v.gate.load();
            if (v.curNote < 0 || (!gate && v.env <= 0.0005f)) {
                v.env = 0.f;
                v.level.store(0.f, std::memory_order_relaxed);
                continue;
            }
            const int pc = ((v.curNote % 12) + 12) % 12;
            const float cents = koma[pc].load();
            const float freq = 440.f * std::exp2((v.curNote - 69) / 12.f + cents / 1200.f);
            const float inc = freq / sr;
            const float amp = v.curVel * 0.2f;
            float ph = v.phase, env = v.env;

            for (int f = 0; f < numFrames; f++) {
                if (gate) { env += atk; if (env > 1.f) env = 1.f; }
                else env *= rel;
                const float a = kTwoPi * ph;
                const float s = std::sin(a) + 0.5f * std::sin(2.f * a) + 0.25f * std::sin(3.f * a);
                out[f * ch] += s * env * amp;
                ph += inc;
                if (ph >= 1.f) ph -= 1.f;
            }
            v.phase = ph;
            v.env = env;
            v.level.store(env, std::memory_order_relaxed);
        }

        const float target = master.load();
        for (int f = 0; f < numFrames; f++) {
            masterSmooth += (target - masterSmooth) * 0.002f;
            const float y = std::tanh(out[f * ch] * masterSmooth);
            for (int c = 0; c < ch; c++) out[f * ch + c] = y;
        }
        return oboe::DataCallbackResult::Continue;
    }

    void onErrorAfterClose(oboe::AudioStream *, oboe::Result result) override {
        if (result == oboe::Result::ErrorDisconnected && wanted.load()) {
            { std::lock_guard<std::mutex> lk(mtx); stream.reset(); }
            open();
        }
    }

private:
    static bool active(const Voice &v) {
        return v.gate.load() || v.level.load(std::memory_order_relaxed) > 0.001f;
    }

    bool open() {
        std::lock_guard<std::mutex> lk(mtx);
        if (stream) return true;
        oboe::AudioStreamBuilder b;
        b.setDirection(oboe::Direction::Output)
            ->setPerformanceMode(oboe::PerformanceMode::LowLatency)
            ->setSharingMode(oboe::SharingMode::Exclusive)
            ->setFormat(oboe::AudioFormat::Float)
            ->setChannelCount(oboe::ChannelCount::Stereo)
            ->setUsage(oboe::Usage::Media)
            ->setContentType(oboe::ContentType::Music)
            ->setFormatConversionAllowed(true)
            ->setChannelConversionAllowed(true)
            ->setCallback(this);
        if (b.openStream(stream) != oboe::Result::OK) { stream.reset(); return false; }
        stream->setBufferSizeInFrames(stream->getFramesPerBurst() * 2);
        sampleRate = (float)stream->getSampleRate();
        channels = stream->getChannelCount();
        if (stream->requestStart() != oboe::Result::OK) {
            stream->close();
            stream.reset();
            return false;
        }
        return true;
    }

    std::shared_ptr<oboe::AudioStream> stream;
    std::mutex mtx;
    std::atomic<bool> wanted{false};
    int32_t channels = 2;
    float sampleRate = 48000.f;
    std::atomic<float> master{0.7f};
    float masterSmooth = 0.7f;
    std::atomic<float> koma[12];
    std::array<Voice, kMaxVoices> voices;
    std::atomic<uint32_t> rr{0};
};

Engine &engine() { static Engine e; return e; }
}  // namespace

extern "C" {
JNIEXPORT jboolean JNICALL
Java_com_example_orientalorg_NativeAudio_nativeStart(JNIEnv *, jobject) { return engine().start(); }

JNIEXPORT void JNICALL
Java_com_example_orientalorg_NativeAudio_nativeStop(JNIEnv *, jobject) { engine().stop(); }

JNIEXPORT void JNICALL
Java_com_example_orientalorg_NativeAudio_nativeNoteOn(JNIEnv *, jobject, jint note, jfloat vel) {
    engine().noteOn(note, vel);
}

JNIEXPORT void JNICALL
Java_com_example_orientalorg_NativeAudio_nativeNoteOff(JNIEnv *, jobject, jint note) {
    engine().noteOff(note);
}

JNIEXPORT void JNICALL
Java_com_example_orientalorg_NativeAudio_nativeAllNotesOff(JNIEnv *, jobject) { engine().allNotesOff(); }

JNIEXPORT void JNICALL
Java_com_example_orientalorg_NativeAudio_nativeSetKomaCents(JNIEnv *, jobject, jint pc, jfloat cents) {
    engine().setKoma(pc, cents);
}

JNIEXPORT void JNICALL
Java_com_example_orientalorg_NativeAudio_nativeSetMasterVolume(JNIEnv *, jobject, jfloat v) {
    engine().setMaster(v);
}
