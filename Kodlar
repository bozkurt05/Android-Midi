package com.example.orientalorg

import android.Manifest
import android.annotation.SuppressLint
import android.content.pm.PackageManager
import android.os.Build
import android.os.Bundle
import android.view.KeyEvent
import android.view.ViewGroup
import android.widget.Button
import android.widget.GridLayout
import android.widget.SeekBar
import android.widget.TextView
import android.widget.Toast
import android.widget.ToggleButton
import androidx.activity.result.contract.ActivityResultContracts
import androidx.appcompat.app.AlertDialog
import androidx.appcompat.app.AppCompatActivity
import androidx.core.content.ContextCompat

@SuppressLint("MissingPermission")
class MainActivity : AppCompatActivity() {

    private lateinit var midi: OrgMidiManager
    private lateinit var tvStatus: TextView
    private val koma = KomaManager()

    private val btPerms: Array<String> =
        if (Build.VERSION.SDK_INT >= 31)
            arrayOf(Manifest.permission.BLUETOOTH_SCAN, Manifest.permission.BLUETOOTH_CONNECT)
        else arrayOf(Manifest.permission.ACCESS_FINE_LOCATION)

    private val permLauncher =
        registerForActivityResult(ActivityResultContracts.RequestMultiplePermissions()) { res ->
            if (res.values.all { it }) scanBluetooth()
            else Toast.makeText(this, "Bluetooth izni gerekli", Toast.LENGTH_SHORT).show()
        }

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_main)

        tvStatus = findViewById(R.id.tvMidiStatus)
        midi = OrgMidiManager(this) { tvStatus.text = it }

        buildKomaButtons()

        val sb = findViewById<SeekBar>(R.id.sbMaster)
        NativeAudio.nativeSetMasterVolume(sb.progress / 100f)
        sb.setOnSeekBarChangeListener(object : SeekBar.OnSeekBarChangeListener {
            override fun onProgressChanged(s: SeekBar, p: Int, fromUser: Boolean) {
                NativeAudio.nativeSetMasterVolume(p / 100f)
            }
            override fun onStartTrackingTouch(s: SeekBar) {}
            override fun onStopTrackingTouch(s: SeekBar) {}
        })

        findViewById<Button>(R.id.btnBluetooth).setOnClickListener {
            val ok = btPerms.all {
                ContextCompat.checkSelfPermission(this, it) == PackageManager.PERMISSION_GRANTED
            }
            if (ok) scanBluetooth() else permLauncher.launch(btPerms)
        }
    }

    private fun buildKomaButtons() {
        val grid = findViewById<GridLayout>(R.id.glKoma)
        val h = (72 * resources.displayMetrics.density).toInt()
        val m = (4 * resources.displayMetrics.density).toInt()
        koma.resetAll()
        for (pc in 0 until 12) {
            val name = koma.noteNames[pc]
            val b = ToggleButton(this).apply {
                textOn = "$name\n−50¢"
                textOff = name
                text = name
                isChecked = false
                layoutParams = GridLayout.LayoutParams(
                    GridLayout.spec(GridLayout.UNDEFINED, 1f),
                    GridLayout.spec(GridLayout.UNDEFINED, 1f)
                ).apply {
                    width = 0
                    height = h
                    setMargins(m, m, m, m)
                }
                setOnCheckedChangeListener { _, checked -> koma.set(pc, checked) }
            }
            grid.addView(b)
        }
    }

    private fun scanBluetooth() {
        tvStatus.text = "Bluetooth MIDI taranıyor (6 sn)…"
        midi.scanBluetooth { list ->
            if (list.isEmpty()) {
                tvStatus.text = "Bluetooth MIDI cihazı bulunamadı"
                return@scanBluetooth
            }
            val names = list.map { d -> runCatching { d.name }.getOrNull() ?: d.address }
            AlertDialog.Builder(this)
                .setTitle("Bluetooth MIDI Cihazı")
                .setItems(names.toTypedArray()) { _, i -> midi.connectBluetooth(list[i]) }
                .show()
        }
    }

    override fun onStart() {
        super.onStart()
        if (!NativeAudio.nativeStart())
            Toast.makeText(this, "Ses motoru başlatılamadı", Toast.LENGTH_LONG).show()
        midi.start()
    }

    override fun onStop() {
        midi.stop()
        NativeAudio.nativeStop()
        super.onStop()
    }

    override fun dispatchKeyEvent(event: KeyEvent): Boolean {
        if (midi.handleKeyEvent(event)) return true
        return super.dispatchKeyEvent(event)
    }
}
